# Copy to .env and fill values. .env is gitignored.

# Cloudflare Radar (Bearer token)
CLOUDFLARE_API_TOKEN=

# VirusTotal v3 API key
VT_API_KEY=

# Shodan API key
SHODAN_API_KEY=

# AbuseIPDB API key
ABUSEIPDB_API_KEY=

# IPInfo token
IPINFO_TOKEN=

# AlienVault OTX API key (optional)
OTX_API_KEY=

# abuse.ch Auth-Key. ONE key covers both URLhaus and ThreatFox, free from https://auth.abuse.ch/.
# Travels in an `Auth-Key` request header, not the query string.
#
# READ docs/OPSEC.md section 4a BEFORE SETTING THIS. abuse.ch's Terms and Conditions prohibit
# automated access by "robot, bot, spider, scraper" (clause 6.2.1), while their API docs issue
# keys and publish curl examples. The operator accepted that exposure on 2026-08-09, including
# for `bulk --investigate`, and it is recorded rather than mitigated. If abuse.ch objects, the
# answer is to stop -- not to rotate keys or change the User-Agent.
ABUSECH_AUTH_KEY=

# NO KEY IS NEEDED for Shodan InternetDB, RDAP or Tranco. They are consulted on every run that
# reaches their scope, so a completely empty file is not a silent run: see docs/OPSEC.md section 4.

# Logging level: 10=DEBUG, 20=INFO, 30=WARN, 40=ERROR
TRIPPER_RECON_LOG_LEVEL=20

# Custom User-Agent for outbound requests.
# LEAVE THIS UNSET unless you have a specific reason. The default is an honest
# `tripper-recon/<version>`. Impersonating a browser buys nothing -- every authenticated
# provider already knows exactly who is calling from the API key -- while creating a
# terms-of-service problem and a hole in the evidence chain. This file used to ship a Chrome
# string here, which silently re-enabled impersonation for anyone who copied it to .env.
#TRIPPER_RECON_USER_AGENT=
